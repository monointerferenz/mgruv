{
  "$schema": "vscode://schemas/color-theme",
  "name": "MGRUV",
  "type": "dark",
  "colors": {
    "focusBorder": "#908377",
    "foreground": "#D4C2A0",
    "descriptionForeground": "#908377",
    "errorForeground": "#C58B8B",
    "widget.shadow": "#17161480",
    "window.activeBorder": "#908377",
    "window.inactiveBorder": "#3A3832",
    "editor.background": "#1E2021",
    "editor.foreground": "#D4C2A0",
    "editorWidget.background": "#30302D",
    "editorWidget.foreground": "#D4C2A0",
    "editorWidget.border": "#47433A",
    "editor.selectionBackground": "#5C6439",
    "editor.inactiveSelectionBackground": "#3A3832",
    "editor.selectionHighlightBackground": "#5C643955",
    "editor.wordHighlightBackground": "#5C643955",
    "editor.wordHighlightStrongBackground": "#9B9B5555",
    "editor.findMatchBackground": "#C6A15B88",
    "editor.findMatchHighlightBackground": "#C6A15B44",
    "editor.hoverHighlightBackground": "#47433A",
    "editor.lineHighlightBackground": "#282828",
    "editorCursor.foreground": "#E8DCB6",
    "editorWhitespace.foreground": "#47433A",
    "editorIndentGuide.background1": "#3A3832",
    "editorIndentGuide.activeBackground1": "#908377",
    "editorRuler.foreground": "#3A3832",
    "editorBracketMatch.background": "#5C643955",
    "editorBracketMatch.border": "#908377",
    "editorGutter.background": "#1E2021",
    "editorLineNumber.foreground": "#6C6C6C",
    "editorLineNumber.activeForeground": "#B8A98A",
    "editorCodeLens.foreground": "#908377",
    "editorLightBulb.foreground": "#C6A15B",
    "editorError.foreground": "#C58B8B",
    "editorWarning.foreground": "#D18A68",
    "editorInfo.foreground": "#7BA6A3",
    "editorHint.foreground": "#908377",
    "editorOverviewRuler.errorForeground": "#C58B8B",
    "editorOverviewRuler.warningForeground": "#D18A68",
    "editorOverviewRuler.infoForeground": "#7BA6A3",
    "editorOverviewRuler.border": "#1E2021",
    "scrollbarSlider.background": "#47433A55",
    "scrollbarSlider.hoverBackground": "#90837777",
    "scrollbarSlider.activeBackground": "#B8A98A88",
    "activityBar.background": "#1E2021",
    "activityBar.foreground": "#E8DCB6",
    "activityBar.inactiveForeground": "#818383",
    "activityBar.activeBorder": "#C6A15B",
    "activityBarBadge.background": "#C6A15B",
    "activityBarBadge.foreground": "#1E2021",
    "sideBar.background": "#282828",
    "sideBar.foreground": "#B8A98A",
    "sideBarTitle.foreground": "#D4C2A0",
    "sideBarSectionHeader.background": "#30302D",
    "sideBarSectionHeader.foreground": "#B8A98A",
    "list.hoverBackground": "#3A3832",
    "list.activeSelectionBackground": "#5C6439",
    "list.activeSelectionForeground": "#E8DCB6",
    "list.inactiveSelectionBackground": "#3A3832",
    "list.inactiveSelectionForeground": "#D4C2A0",
    "list.focusBackground": "#5C6439",
    "list.highlightForeground": "#DEC17A",
    "tree.indentGuidesStroke": "#47433A",
    "statusBar.background": "#3A3832",
    "statusBar.foreground": "#D4C2A0",
    "statusBarItem.hoverBackground": "#47433A",
    "statusBarItem.remoteBackground": "#7BA6A3",
    "statusBarItem.remoteForeground": "#1E2021",
    "titleBar.activeBackground": "#1E2021",
    "titleBar.activeForeground": "#D4C2A0",
    "titleBar.inactiveBackground": "#1E2021",
    "titleBar.inactiveForeground": "#818383",
    "tab.activeBackground": "#1E2021",
    "tab.activeForeground": "#E8DCB6",
    "tab.inactiveBackground": "#282828",
    "tab.inactiveForeground": "#818383",
    "tab.activeBorderTop": "#C6A15B",
    "tab.border": "#1E2021",
    "editorGroupHeader.tabsBackground": "#282828",
    "editorGroupHeader.noTabsBackground": "#1E2021",
    "panel.background": "#1E2021",
    "panel.border": "#47433A",
    "panelTitle.activeForeground": "#E8DCB6",
    "panelTitle.inactiveForeground": "#818383",
    "panelTitle.activeBorder": "#C6A15B",
    "terminal.background": "#1E2021",
    "terminal.foreground": "#D4C2A0",
    "terminalCursor.foreground": "#E8DCB6",
    "terminal.ansiBlack": "#1E2021",
    "terminal.ansiRed": "#C58B8B",
    "terminal.ansiGreen": "#86A987",
    "terminal.ansiYellow": "#C6A15B",
    "terminal.ansiBlue": "#7E9FC0",
    "terminal.ansiMagenta": "#9B829B",
    "terminal.ansiCyan": "#7BA6A3",
    "terminal.ansiWhite": "#D4C2A0",
    "terminal.ansiBrightBlack": "#6C6C6C",
    "terminal.ansiBrightRed": "#E0A5A0",
    "terminal.ansiBrightGreen": "#AAC49D",
    "terminal.ansiBrightYellow": "#DEC17A",
    "terminal.ansiBrightBlue": "#A9BED2",
    "terminal.ansiBrightMagenta": "#C0A6B9",
    "terminal.ansiBrightCyan": "#A8C5B7",
    "terminal.ansiBrightWhite": "#E8DCB6",
    "gitDecoration.addedResourceForeground": "#86A987",
    "gitDecoration.modifiedResourceForeground": "#C6A15B",
    "gitDecoration.deletedResourceForeground": "#C58B8B",
    "gitDecoration.untrackedResourceForeground": "#7BA6A3",
    "testing.iconPassed": "#86A987",
    "testing.iconFailed": "#C58B8B",
    "testing.iconQueued": "#C6A15B",
    "debugToolBar.background": "#30302D",
    "debugIcon.breakpointForeground": "#C58B8B",
    "ports.iconRunningProcessForeground": "#7BA6A3"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#818383", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#B9828E" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#DEC17A" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#86A987" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#D4C2A0" } },
    { "scope": ["variable.language", "variable.annotation", "this", "super"], "settings": { "foreground": "#9B829B" } },
    { "scope": ["constant", "constant.language", "support.constant", "entity.name.constant"], "settings": { "foreground": "#C6A15B" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#AAC49D" } },
    { "scope": ["constant.numeric", "constant.character", "constant.other", "keyword.operator"], "settings": { "foreground": "#D18A68" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#C58B8B" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#C6A15B" } },
    { "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#E8DCB6", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#B8A98A", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#A9BED2" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E8DCB6", "background": "#754B4B" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#908377" } },
    { "scope": ["support", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#7E9FC0" } }
  ],
  "semanticTokenColors": {
    "class": "#86A987",
    "enum": "#86A987",
    "interface": "#86A987",
    "function": "#DEC17A",
    "method": "#DEC17A",
    "variable": "#D4C2A0",
    "parameter": "#B8A98A",
    "property": "#7E9FC0",
    "string": "#AAC49D",
    "number": "#D18A68",
    "keyword": "#B9828E",
    "comment": "#818383"
  }
}
